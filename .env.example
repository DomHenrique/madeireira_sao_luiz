# ============================================================
# Madereira São Luiz — Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores
# ============================================================

# Segurança Django
SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=saoluiz.griddmkt360.com.br,www.saoluiz.griddmkt360.com.br

# ── CSRF (OBRIGATÓRIO em produção com HTTPS) ──────────────────
# Inclua o protocolo (https://) e todos os domínios/subdomínios.
# SEM isso o login do admin retorna 403 Forbidden.
CSRF_TRUSTED_ORIGINS=https://saoluiz.griddmkt360.com.br, https://www.saoluiz.griddmkt360.com.br

# ── Cookies seguros (ative apenas com HTTPS ativo) ───────────
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_SECURE=True

# ── Proxy SSL (ative se usar nginx/Cloudflare terminando TLS) ─
# Informa ao Django que a requisição chegou via HTTPS
TRUST_PROXY_SSL=True

# Banco de Dados PostgreSQL (Supabase)
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:your-password@db.xxxxxxxxxxxx.supabase.co:5432/postgres

# Supabase Storage (S3-compatible)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# AWS/S3 (usado pelo django-storages para acessar Supabase Storage)
AWS_ACCESS_KEY_ID=your-supabase-service-role-or-storage-key
AWS_SECRET_ACCESS_KEY=your-supabase-storage-secret
AWS_STORAGE_BUCKET_NAME=madereira-sao-luiz
AWS_S3_ENDPOINT_URL=https://xxxxxxxxxxxx.supabase.co/storage/v1/s3
AWS_S3_REGION_NAME=sa-east-1
USE_SUPABASE_STORAGE=True
